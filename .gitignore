# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Virtual environment
venv/
env/
ENV/
.venv/

# Database (auto-generated by app.py on first run)
*.db
*.sqlite3

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# Generated test/examination artifacts
evidence/original/*
evidence/working/*
!evidence/original/.gitkeep
!evidence/working/.gitkeep
reports/*.pdf
!reports/.gitkeep
